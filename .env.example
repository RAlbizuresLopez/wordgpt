# Este archivo vive únicamente en el Mac mini que ejecuta Ollama.
# Ollama no se expone a la red; el gateway le habla por localhost.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
# 8k cubre consultas sobre la selección o un documento breve sin agotar memoria.
OLLAMA_CONTEXT_LENGTH=8192
# Cuando se publique con Tailscale Serve, fija el correo de la usuaria invitada.
# Tailscale añade este dato de identidad y elimina cabeceras falsificadas.
ALLOWED_TAILSCALE_USER_LOGIN=
PORT=3000
